---
export interface Props {
  variant?: 'default' | 'popular' | 'primary' | 'accent' | 'success'
  size?: 'sm' | 'md'
}

const { variant = 'default', size = 'sm' } = Astro.props

const variants: Record<string, string> = {
  default: 'bg-muted text-muted-foreground border-border/60',
  popular: 'bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-800',
  primary: 'bg-primary/10 text-primary border-primary/20',
  accent: 'bg-accent/10 text-accent-foreground border-accent/20',
  success: 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800',
}

const sizes: Record<string, string> = {
  sm: 'text-xs px-2 py-0.5',
  md: 'text-sm px-2.5 py-0.5',
}
---

<span class={`inline-flex items-center gap-1 border rounded-full font-medium ${variants[variant]} ${sizes[size]}`}>
  <slot />
</span>
