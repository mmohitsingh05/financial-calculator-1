---
import { MegaMenu } from '@/components/layout/MegaMenu'
import { ThemeToggle } from '@/components/layout/ThemeToggle'
---

<nav class="bg-background/80 backdrop-blur-sm border-b border-border sticky top-0 z-50 shadow-[--shadow-xs]" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-primary tracking-tight">
      FinCalc Pro
    </a>

    <div class="flex items-center gap-1">
      <ThemeToggle client:load />
      <MegaMenu client:load />
    </div>
  </div>
  <div class="h-[1px] bg-gradient-to-r from-transparent via-primary/20 to-transparent" />
</nav>
