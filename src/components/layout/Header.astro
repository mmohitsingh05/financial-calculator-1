---
import { categories, getToolsByCategory } from '@/data/tools'
---

<nav class="bg-background border-b border-border" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-primary tracking-tight">
      FinCalc Pro
    </a>

    <div class="flex items-center gap-1">
      <div class="group relative">
        <button
          class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-md hover:bg-muted cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Calculators
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div class="absolute right-0 top-full mt-1 w-[640px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          <div class="bg-card border border-border rounded-lg shadow-lg p-6 grid grid-cols-3 gap-6">
            {categories.map(cat => (
              <div>
                <a
                  href={`/calculators/${cat.slug}/`}
                  class="block text-sm font-semibold text-foreground mb-2 hover:text-primary transition-colors"
                >
                  {cat.name}
                </a>
                <ul class="space-y-1">
                  {getToolsByCategory(cat.id).map(tool => (
                    <li>
                      <a
                        href={`/calculators/${cat.slug}/${tool.slug}/`}
                        class="block text-xs text-muted-foreground hover:text-foreground hover:underline transition-colors py-0.5"
                      >
                        {tool.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>