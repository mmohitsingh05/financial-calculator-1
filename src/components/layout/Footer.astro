---
import { categories, getToolsByCategory } from '@/data/tools'
---

<footer class="border-t border-border bg-background relative" style="border-top-width: 1px;">
  <div class="absolute inset-0 bg-gradient-to-t from-primary/5 to-transparent pointer-events-none" />
  <div class="absolute inset-0 shadow-[--shadow-xs] opacity-50" />
  <div class="max-w-7xl mx-auto px-4 py-12 relative">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-10">
      {categories.map(cat => (
        <div>
          <a
            href={`/calculators/${cat.slug}/`}
            class="block text-xs font-semibold text-foreground uppercase tracking-wider mb-3 hover:text-primary transition-colors"
          >
            {cat.name}
          </a>
          <ul class="space-y-1.5">
            {getToolsByCategory(cat.id).map(tool => (
              <li>
                <a
                  href={`/calculators/${cat.slug}/${tool.slug}/`}
                  class="block text-xs text-muted-foreground hover:text-foreground hover:underline transition-colors"
                >
                  {tool.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-border pt-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-6">
        <div class="flex flex-wrap justify-center gap-6 text-xs text-muted-foreground">
          <a href="/about/" class="hover:text-foreground transition-colors">About</a>
          <a href="/contact/" class="hover:text-foreground transition-colors">Contact</a>
          <a href="/privacy-policy/" class="hover:text-foreground transition-colors">Privacy</a>
          <a href="/terms-of-service/" class="hover:text-foreground transition-colors">Terms</a>
          <a href="/disclaimer/" class="hover:text-foreground transition-colors">Disclaimer</a>
        </div>
        <p class="text-xs text-muted-foreground">
          &copy; {new Date().getFullYear()} FinCalc Pro. All rights reserved.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6 mb-6">
        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="size-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <use href="/icons.svg#diamond" />
          </svg>
          100% Free
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="size-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <use href="/icons.svg#lock" />
          </svg>
          No Data Stored
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
          <svg class="size-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <use href="/icons.svg#device-mobile" />
          </svg>
          Mobile Friendly
        </span>
      </div>

      <div class="text-center text-xs text-muted-foreground max-w-2xl mx-auto">
        <p>
          This calculator is for informational purposes only and does not constitute financial advice.
          Results are estimates based on the information you provide. Consult a qualified financial
          professional for advice specific to your situation.
        </p>
      </div>
    </div>
  </div>
</footer>