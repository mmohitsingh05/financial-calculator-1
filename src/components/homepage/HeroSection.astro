---
import { tools } from '@/data/tools'
---

<section class="px-4">
  <div class="relative overflow-hidden rounded-[2.5rem]">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/8 via-primary/3 to-background pointer-events-none" />
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 24px 24px;" />
    <div class="max-w-7xl mx-auto px-4 pt-20 pb-20 text-center relative">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4 leading-tight">
        Make Smarter<br class="sm:hidden" />
        <span class="text-primary">Financial Decisions</span>
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed">
        31 free calculators for mortgages, loans, retirement, investing,
        salary, and taxes — all 100% free, no sign-up required.
      </p>

      <a
        href="/calculators/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-primary text-primary-foreground font-semibold text-base hover:brightness-110 transition-all duration-200 shadow-lg shadow-primary/20"
      >
        Browse All 31 Calculators
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <use href="/icons.svg#arrow-right" />
        </svg>
      </a>

      <div class="mt-14 grid grid-cols-3 gap-6 max-w-lg mx-auto">
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">{tools.length}</p>
          <p class="text-xs text-muted-foreground mt-1">Calculators</p>
        </div>
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">6</p>
          <p class="text-xs text-muted-foreground mt-1">Categories</p>
        </div>
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">100%</p>
          <p class="text-xs text-muted-foreground mt-1">Free & Private</p>
        </div>
      </div>
    </div>
  </div>
</section>