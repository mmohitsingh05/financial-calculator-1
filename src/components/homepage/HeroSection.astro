---
import { tools } from '@/data/tools'
---

<section class="px-4">
  <div class="relative overflow-hidden rounded-[2.5rem]">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/8 via-primary/3 to-background pointer-events-none" />
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 24px 24px;" />

    <!-- Floating animated icons -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <svg class="absolute top-14 left-[10%] size-7 sm:size-9 lg:size-10 text-primary/15 animate-float-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <svg class="absolute top-24 right-[12%] size-6 sm:size-8 lg:size-9 text-primary/12 animate-float-reverse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
      </svg>
      <svg class="absolute bottom-16 left-[15%] size-5 sm:size-7 lg:size-8 text-primary/10 animate-float" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125V9M7.5 12.75c1.5 0 2.25-1.5 2.25-3S9 6.75 7.5 6.75 5.25 8.25 5.25 10.5s.75 2.25 2.25 2.25z" />
      </svg>
      <svg class="absolute bottom-20 right-[18%] size-5 sm:size-6 lg:size-7 text-primary/15 animate-float-reverse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.125 2.25h-4.5c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125v-9M10.125 2.25h.375a9 9 0 019 9v.375M10.125 2.25A3.375 3.375 0 0113.5 5.625v1.5c0 .621.504 1.125 1.125 1.125h1.5a3.375 3.375 0 013.375 3.375M9 15l2.25 2.25L15 12" />
      </svg>
      <svg class="absolute top-1/2 left-[6%] -translate-y-1/2 size-4 sm:size-5 lg:size-6 text-primary/10 animate-pulse-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <svg class="absolute top-1/3 right-[8%] size-3 sm:size-4 lg:size-5 text-primary/15 animate-float-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
      </svg>
      <svg class="absolute bottom-1/3 right-[6%] size-4 sm:size-5 lg:size-6 text-primary/8 animate-float" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 pt-20 pb-20 text-center relative">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4 leading-tight">
        Make Smarter<br class="sm:hidden" />
        <span class="text-primary">Financial Decisions</span>
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed">
        31 free calculators for mortgages, loans, retirement, investing,
        salary, and taxes — all 100% free, no sign-up required.
      </p>

      <a
        href="/calculators/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-primary text-primary-foreground font-semibold text-base hover:brightness-110 transition-all duration-200 shadow-lg shadow-primary/20"
      >
        Browse All 31 Calculators
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <use href="/icons.svg#arrow-right" />
        </svg>
      </a>

      <div class="mt-14 grid grid-cols-3 gap-6 max-w-lg mx-auto">
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">{tools.length}</p>
          <p class="text-xs text-muted-foreground mt-1">Calculators</p>
        </div>
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">6</p>
          <p class="text-xs text-muted-foreground mt-1">Categories</p>
        </div>
        <div class="text-center p-3">
          <p class="text-2xl md:text-3xl font-bold text-foreground">100%</p>
          <p class="text-xs text-muted-foreground mt-1">Free & Private</p>
        </div>
      </div>
    </div>
  </div>
</section>
