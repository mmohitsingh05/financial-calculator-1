---
---

<section class="px-4">
  <div class="relative overflow-hidden rounded-[2.5rem]">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/10 via-background to-primary/10 pointer-events-none" />
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 28px 28px;" />
    <div class="max-w-7xl mx-auto px-4 py-16 md:py-24 text-center relative">
      <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-3">
        Ready to Take Control?
      </h2>
      <p class="text-muted-foreground max-w-lg mx-auto mb-8">
        Start with any of our 31 calculators. No account, no spam, no data sharing — just fast, accurate answers.
      </p>
      <a
        href="/calculators/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-primary text-primary-foreground font-semibold text-base hover:bg-primary/90 transition-all duration-200 shadow-[--shadow-md] cursor-pointer"
      >
        Browse All Calculators
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <use href="/icons.svg#arrow-right" />
        </svg>
      </a>
    </div>
  </div>
</section>