---
const features = [
  {
    title: '100% Free',
    desc: 'Every calculator is free to use. No subscriptions, no hidden fees, no credit card required.',
    icon: 'diamond',
  },
  {
    title: 'Your Data Stays Private',
    desc: 'All calculations run in your browser. We never store or transmit your financial information.',
    icon: 'lock',
  },
  {
    title: 'Always Accurate',
    desc: 'Updated with the latest 2026 tax brackets, contribution limits, and interest rate formulas.',
    icon: 'circle-check',
  },
  {
    title: 'Works Everywhere',
    desc: 'Mobile-friendly, responsive design. Use on your phone, tablet, or desktop — anytime.',
    icon: 'device-mobile',
  },
]
---

<section class="max-w-7xl mx-auto px-4 py-16 md:py-24">
    <h2 class="text-2xl md:text-3xl font-bold text-foreground text-center mb-10">
      Why FinCalc Pro?
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(f => (
        <div class="text-center p-6 rounded-2xl bg-card border border-border/80 shadow-[--shadow-sm] hover:shadow-[--shadow-md] hover:border-primary/25 hover:-translate-y-0.5 transition-all duration-300">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary mb-4">
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <use href={`/icons.svg#${f.icon}`} />
            </svg>
          </span>
          <h3 class="font-semibold text-foreground mb-2">{f.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
</section>