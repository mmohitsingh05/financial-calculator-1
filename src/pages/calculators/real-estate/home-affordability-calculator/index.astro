---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { HomeAffordabilityCalculator } from '@/components/calculators/home-affordability-calculator/index.tsx'

const tool = getToolBySlug('home-affordability-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'home-affordability-calculator')
const { data } = entry!
---

<CalculatorLayout
  title="Home Affordability Calculator - How Much House Can You Afford? | FinCalc Pro"
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <HomeAffordabilityCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>home affordability calculator</strong> helps you determine how much house you can afford based on your income, debts, and down payment. Using the 28/36 rule, get a lender-approved budget before you start house hunting.
  </p>
  <div slot="how-to-use">
    <p>Enter your annual household income, monthly debt payments, down payment amount, expected interest rate, loan term, annual property tax rate, and annual home insurance. The calculator will show your maximum affordable home price, estimated monthly payment, and how the 28/36 rule applies to your situation.</p>
  </div>
  <div slot="formula">
    <p>The 28/36 rule determines your maximum housing payment: 28% of gross monthly income for housing (front-end) and 36% for total debt including housing (back-end). The amortization formula is solved in reverse to find the maximum loan amount given your affordable monthly payment, then your down payment is added to find the maximum home price.</p>
  </div>
</CalculatorLayout>
