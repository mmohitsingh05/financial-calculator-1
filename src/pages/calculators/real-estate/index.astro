---
import Layout from '@/layouts/Layout.astro'
import { getToolBySlug } from '@/data/tools'
import { getCollection } from 'astro:content'

const [entry] = await getCollection('categories', ({ id }) => id === 'real-estate')
const { data: category } = entry

const toolsData = category.tools.map(slug => getToolBySlug(slug)!).filter(Boolean)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: '' },
]
const title = 'Real Estate & Housing Calculators - Free Home Affordability & Rent vs Buy | FinCalc Pro'
---

<Layout {title} description={category.description} {breadcrumbs}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{category.name}</h1>

    <p class="text-muted-foreground mb-8 max-w-3xl">
      {category.description}
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {toolsData.map(tool => (
        <a
          href={`/calculators/real-estate/${tool.slug}/`}
          class="block p-5 rounded-lg border border-border bg-card hover:border-primary/50 hover:shadow-sm transition-all"
        >
          <h2 class="text-base font-semibold text-foreground mb-1">{tool.name}</h2>
          <p class="text-sm text-muted-foreground">{tool.description}</p>
        </a>
      ))}
    </div>
  </article>
</Layout>
