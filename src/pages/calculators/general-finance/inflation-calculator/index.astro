---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getCollection } from 'astro:content'
import { InflationCalculator } from '@/components/calculators/inflation-calculator/index.tsx'

const tool = getToolBySlug('inflation-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const [entry] = await getCollection('tools', ({ id }) => id === 'inflation-calculator')
const { data } = entry
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title="Inflation Calculator - See How Inflation Affects Your Money | FinCalc Pro" description={data.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={data.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      An <strong>inflation calculator</strong> reveals how the purchasing power of money changes over time. See what your money was worth in the past or what it will be worth in the future as inflation silently erodes its value.
    </p>

    <div class="my-8" id="calculator">
      <InflationCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter the dollar amount, the expected inflation rate, and the number of years. Click Calculate to see how inflation affects your money: the future value (what your money will be worth), the past value (what your money was worth), and the purchasing power lost.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>The calculator uses the compound inflation formula:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">Future Value = Present Value × (1 + inflation_rate)^t</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">Past Value = Present Value / (1 + inflation_rate)^t</p>
        <p>Future value shows what a given amount will be worth after inflation eats away at purchasing power. Past value shows what a given amount was worth in the past, adjusted for inflation.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>