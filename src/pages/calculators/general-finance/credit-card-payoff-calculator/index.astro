---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { CreditCardPayoffCalculator } from '@/components/calculators/credit-card-payoff-calculator/index.tsx'

const tool = getToolBySlug('credit-card-payoff-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'credit-card-payoff-calculator')
const { data } = entry!
---

<CalculatorLayout
  title="Credit Card Payoff Calculator - Get Debt Free Faster | FinCalc Pro"
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <CreditCardPayoffCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>credit card payoff calculator</strong> shows you how long it takes to become debt-free. Compare making minimum payments versus a fixed monthly payment to see how much interest you can save.
  </p>
  <div slot="how-to-use">
    <p>Enter your current credit card balance, APR, your desired monthly payment, and the minimum payment percentage. The calculator compares two scenarios side by side: paying only the minimum versus your chosen payment amount, showing months to payoff and total interest for each.</p>
  </div>
  <div slot="formula">
    <p>A month-by-month simulation applies the monthly periodic rate (APR / 12) to the remaining balance. Each month's interest is subtracted from the payment; the remainder reduces the principal. The simulation repeats until the balance reaches zero, tracking total months and cumulative interest paid.</p>
  </div>
</CalculatorLayout>
