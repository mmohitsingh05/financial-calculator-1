---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getEntry } from 'astro:content'
import { InvestmentGrowthCalculator } from '@/components/calculators/investment-growth-calculator/index.tsx'

const tool = getToolBySlug('investment-growth-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const entry = await getEntry('tools', 'investment-growth-calculator')
const { data } = entry!
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title="Investment Growth Calculator - Project Your Returns | FinCalc Pro" description={tool.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={tool.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      An <strong>investment calculator</strong> gives you a realistic projection of how your money can grow over time through the power of compounding returns. Whether you have a lump sum to invest or plan to contribute regularly, this tool shows your potential future value.
    </p>

    <div class="my-8" id="calculator">
      <InvestmentGrowthCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Start by entering your current investment balance, then the amount you'll contribute each month. Enter your expected annual return rate, the number of years you plan to invest, and an estimated inflation rate. The calculator shows your projected future value in nominal and inflation-adjusted terms, so you can see the true purchasing power of your savings.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>The future value combines lump sum growth with the future value of an annuity for recurring contributions:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">FV = P × (1 + r/n)^(n×t) + PMT × [ ((1 + r/n)^(n×t) − 1) / (r/n) ]</p>
        <p>With inflation adjustment: Real FV = FV / (1 + inflation_rate)^t, giving you a more honest picture of what your future savings will be worth in today's dollars.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>