---
import Layout from '@/layouts/Layout.astro'
import Badge from '@/components/ui/Badge.astro'
import { getToolBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'

const categoryEntry = await getEntry('categories', 'investment')
const { data: category } = categoryEntry
const tools = category.tools.map((slug: string) => getToolBySlug(slug)!).filter(Boolean)
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: '' },
]
const categoryIcons: Record<string, string> = {
  loan: 'building-bank',
  investment: 'trending-up',
  retirement: 'calendar-check',
  'salary-tax': 'file-dollar',
  'general-finance': 'wallet',
  'real-estate': 'home',
}
---

<Layout title="Investment & Savings Calculators - Free Online | FinCalc Pro" description={category.description} breadcrumbs={breadcrumbs}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{category.name}</h1>
    <p class="text-muted-foreground mb-8 max-w-3xl">{category.description}</p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool, i) => (
        <a
          href={`/calculators/${tool.category}/${tool.slug}/`}
          class={`group p-5 rounded-xl border border-border bg-card hover:border-primary/30 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 animate-fade-in-up stagger-${i + 1}`}
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <span class="p-2 rounded-lg bg-primary/10 text-primary">
              <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <use href={`/icons.svg#${categoryIcons[tool.category] || 'calculator'}`} />
              </svg>
            </span>
            {tool.tier === 'high' && (
              <Badge variant="popular" size="sm">
                <svg class="size-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="m12 17.75l-6.172 3.245l1.179-6.873l-5-4.867l6.9-1l3.086-6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z"/>
                </svg>
                Popular
              </Badge>
            )}
          </div>
          <h2 class="font-semibold text-foreground group-hover:text-primary transition-colors text-sm leading-snug">{tool.name}</h2>
          <p class="text-xs text-muted-foreground mt-1.5 line-clamp-2">{tool.description}</p>
        </a>
      ))}
    </div>
  </article>
</Layout>
