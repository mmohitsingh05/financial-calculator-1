---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { CDCalculator } from '@/components/calculators/cd-calculator/index.tsx'

const tool = getToolBySlug('cd-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'cd-calculator')
const { data } = entry!
---

<CalculatorLayout
  title="CD Calculator - Certificate of Deposit Returns | FinCalc Pro"
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <CDCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>CD calculator</strong> helps you compare Certificate of Deposit options and understand exactly how much your money will earn. CDs offer a safe, FDIC-insured way to earn guaranteed returns on your savings at higher rates than regular savings accounts.
  </p>
  <div slot="how-to-use">
    <p>Enter the amount you plan to deposit, the CD term in months, the annual interest rate (APY), and how often interest compounds. The calculator shows the total value at maturity, total interest earned, and the effective APY. Compare different terms and rates to find the best CD for your savings goals.</p>
  </div>
  <div slot="formula">
    <p>CDs use the compound interest formula (typically without additional contributions after the initial deposit):</p>
    <p class="font-mono text-sm bg-muted p-3 rounded">FV = P × (1 + r/n)^(n×t)</p>
    <p>Where P is the initial deposit, r is the annual interest rate, n is the compounding frequency (often daily or monthly for CDs), and t is the term in years. The effective APY accounts for the compounding effect.</p>
  </div>
</CalculatorLayout>
