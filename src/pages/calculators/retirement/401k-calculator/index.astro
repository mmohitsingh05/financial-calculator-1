---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getEntry } from 'astro:content'
import { FourOneKCalculator } from '@/components/calculators/401k-calculator/index.tsx'

const tool = getToolBySlug('401k-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const entry = await getEntry('tools', '401k-calculator')
const { data } = entry!
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title={`${tool.name} - Project Your Retirement Savings | FinCalc Pro`} description={data.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={data.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      A <strong>401k calculator</strong> helps you project your retirement savings including employer match contributions. See how your deferrals, company match, and investment growth add up over time.
    </p>

    <div class="my-8" id="calculator">
      <FourOneKCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter your current age, current 401(k) balance, and annual salary. Set your employee contribution percentage and your employer's match rate and cap — for example, "100% match up to 6% of salary." Enter your expected annual return and target retirement age. Click Project Savings to see your estimated balance at retirement, total personal contributions, and the total employer match earned.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>The 401(k) projection uses the future value formula:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">FV = Current_Balance × (1 + r/n)^(n×t) + Total_Contribution_Per_Period × [ ((1 + r/n)^(n×t) − 1) / (r/n) ]</p>
        <p>Total Contribution Per Period = Employee Contribution + Employer Match. The employer match is capped by the plan's formula and the annual IRS contribution limit ($23,500 for 2026). The calculator assumes monthly compounding consistent with payroll contributions.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>
