---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getEntry } from 'astro:content'
import { SocialSecurityCalculator } from '@/components/calculators/social-security-calculator/index.tsx'

const tool = getToolBySlug('social-security-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const entry = await getEntry('tools', 'social-security-calculator')
const { data } = entry!
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title="Social Security Calculator - Estimate Your Benefits | FinCalc Pro" description={tool.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={tool.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      A <strong>Social Security calculator</strong> helps you make one of the most important retirement decisions: when to claim your benefits. The difference between claiming at 62 versus 70 can mean hundreds of thousands of dollars over your lifetime.
    </p>

    <div class="my-8" id="calculator">
      <SocialSecurityCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter your estimated benefit at Full Retirement Age (find this on your Social Security statement at ssa.gov), your current age, your Full Retirement Age, and the age you plan to claim. The calculator shows your estimated monthly benefit and how it compares to your FRA benefit.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>This is a simplified educational estimator based on Social Security's adjustment factors:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">Benefit_at_claim_age = FRA_Benefit × adjustment_factor</p>
        <p>Claiming before FRA reduces your benefit by about 5/9 of 1% per month for the first 36 months early, plus 5/12 of 1% per month beyond that. Claiming after FRA increases your benefit by about 8% per year through delayed retirement credits up to age 70.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>