---
import Layout from '@/layouts/Layout.astro'
import { getToolBySlug } from '@/data/tools'
import { getCollection } from 'astro:content'

const [categoryEntry] = await getCollection('categories', ({ id }) => id === 'retirement')
const { data: category } = categoryEntry
const tools = category.tools.map((slug: string) => getToolBySlug(slug)!).filter(Boolean)
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: '' },
]
---

<Layout title="Retirement Calculators - Free 401(k), IRA & Retirement Planning | FinCalc Pro" description={category.description} breadcrumbs={breadcrumbs}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{category.name}</h1>
    <p class="text-muted-foreground mb-8">{category.description}</p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map(tool => (
        <a
          href={`/calculators/${tool.category}/${tool.slug}/`}
          class="block p-5 bg-card border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all"
        >
          <h2 class="text-lg font-semibold text-foreground mb-1">{tool.name}</h2>
          <p class="text-sm text-muted-foreground">{tool.description}</p>
        </a>
      ))}
    </div>
  </article>
</Layout>
