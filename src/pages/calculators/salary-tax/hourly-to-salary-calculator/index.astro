---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { HourlyToSalaryCalculator } from '@/components/calculators/hourly-to-salary-calculator/index.tsx'

const tool = getToolBySlug('hourly-to-salary-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'hourly-to-salary-calculator')
const { data } = entry!
---

<CalculatorLayout
  title="Hourly to Salary Calculator - Convert Your Wage | FinCalc Pro"
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <HourlyToSalaryCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    An <strong>hourly to salary calculator</strong> helps you convert your hourly wage into annual, monthly, bi-weekly, and weekly pay. Whether you're negotiating a job offer or comparing compensation packages, know exactly what your time is worth.
  </p>
  <div slot="how-to-use">
    <p>Enter your hourly rate, the number of hours you work per week, and the number of weeks you work per year. If you regularly work overtime, enter your average overtime hours per week. Click Calculate to see your annual salary, monthly pay, bi-weekly pay, weekly pay, overtime rate, and weekly pay including overtime.</p>
  </div>
  <div slot="formula">
    <p>The conversion uses simple multiplication:</p>
    <p class="font-mono text-sm bg-muted p-3 rounded">Annual Salary = Hourly Rate × Hours per Week × Weeks per Year</p>
    <p>Your hourly rate is divided into annual salary, then split into monthly (annual / 12), bi-weekly (annual / 26), and weekly (annual / 52). Overtime is calculated at 1.5× your regular hourly rate for hours exceeding 40 per week.</p>
  </div>
</CalculatorLayout>
