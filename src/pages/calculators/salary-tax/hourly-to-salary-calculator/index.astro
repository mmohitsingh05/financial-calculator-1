---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getCollection } from 'astro:content'
import { HourlyToSalaryCalculator } from '@/components/calculators/hourly-to-salary-calculator/index.tsx'

const tool = getToolBySlug('hourly-to-salary-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const [entry] = await getCollection('tools', ({ id }) => id === 'hourly-to-salary-calculator')
const { data } = entry
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title="Hourly to Salary Calculator - Convert Your Wage | FinCalc Pro" description={tool.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={tool.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      An <strong>hourly to salary calculator</strong> helps you convert your hourly wage into annual, monthly, bi-weekly, and weekly pay. Whether you're negotiating a job offer or comparing compensation packages, know exactly what your time is worth.
    </p>

    <div class="my-8" id="calculator">
      <HourlyToSalaryCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter your hourly rate, the number of hours you work per week, and the number of weeks you work per year. If you regularly work overtime, enter your average overtime hours per week. Click Calculate to see your annual salary, monthly pay, bi-weekly pay, weekly pay, overtime rate, and weekly pay including overtime.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>The conversion uses simple multiplication:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">Annual Salary = Hourly Rate × Hours per Week × Weeks per Year</p>
        <p>Your hourly rate is divided into annual salary, then split into monthly (annual / 12), bi-weekly (annual / 26), and weekly (annual / 52). Overtime is calculated at 1.5× your regular hourly rate for hours exceeding 40 per week.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>