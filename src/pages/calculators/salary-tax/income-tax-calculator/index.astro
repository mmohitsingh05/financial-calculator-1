---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { IncomeTaxCalculator } from '@/components/calculators/income-tax-calculator/index.tsx'

const tool = getToolBySlug('income-tax-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'income-tax-calculator')
const { data } = entry!
---

<CalculatorLayout
  title="Income Tax Calculator - Estimate Your Federal Taxes | FinCalc Pro"
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
  taxYear="2026"
>
  <div slot="calculator">
    <IncomeTaxCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    An <strong>income tax calculator</strong> helps you estimate your federal tax bill based on your income and filing status. Understand your effective and marginal tax rates and plan ahead for tax season.
  </p>
  <div slot="how-to-use">
    <p>Enter your annual gross income and select your filing status. The calculator applies the 2026 standard deduction and progressive tax brackets to compute your taxable income, total federal tax, effective tax rate, and marginal tax rate.</p>
  </div>
  <div slot="formula">
    <p>Taxable income = gross income − standard deduction (based on filing status). Tax is computed using progressive brackets: each portion of income is taxed at its corresponding rate. The effective tax rate is total tax divided by gross income. The marginal rate is the bracket your last dollar of income falls into.</p>
  </div>
</CalculatorLayout>
