---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { PersonalLoanCalculator } from '@/components/calculators/personal-loan-calculator/index.tsx'

const tool = getToolBySlug('personal-loan-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'personal-loan-calculator')
const { data } = entry!
---

<CalculatorLayout
  title={`Personal Loan Calculator - Estimate Your Monthly Payment | FinCalc Pro`}
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <PersonalLoanCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>personal loan calculator</strong> helps you plan your borrowing by showing your monthly payments, total interest, and the true cost including any origination fees. Whether you're consolidating debt or funding a large purchase, know your numbers before you apply.
  </p>
  <div slot="how-to-use">
    <p>Enter the loan amount you need, the APR you expect to qualify for, and the repayment term in years. If your lender charges an origination fee, enter that as well — it affects your amount financed and effective APR. Click Calculate to see your monthly payment, total interest paid, total cost, and the true APR with any fees included.</p>
  </div>
  <div slot="formula">
    <p>Personal loans use the standard amortization formula:</p>
    <p class="font-mono text-sm bg-muted p-3 rounded">M = P × [ i(1+i)^N ] / [ (1+i)^N − 1 ]</p>
    <p>Where P is the loan amount, i is the monthly interest rate (APR / 12), and N is the total number of monthly payments. If an origination fee is charged, the effective APR is calculated as the rate where the present value of all payments equals the amount you actually receive (P minus the fee).</p>
  </div>
</CalculatorLayout>
