---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { LoanPayoffCalculator } from '@/components/calculators/loan-payoff-calculator/index.tsx'

const tool = getToolBySlug('loan-payoff-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'loan-payoff-calculator')
const { data } = entry!
---

<CalculatorLayout
  title={`Loan Payoff Calculator - Pay Off Your Loan Faster | FinCalc Pro`}
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <LoanPayoffCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>loan payoff calculator</strong> shows you how extra payments can shorten your loan term and save thousands in interest. Whether it's a mortgage, auto loan, student loan, or personal loan, see the impact of paying more each month.
  </p>
  <div slot="how-to-use">
    <p>Enter your current loan balance, interest rate, and remaining term. Then set an extra monthly payment amount. The calculator compares your original payoff schedule against the accelerated one, showing how many months you'll save and how much interest you'll avoid paying.</p>
  </div>
  <div slot="formula">
    <p>This calculator runs an iterative month-by-month simulation. In each period, the extra payment is applied directly to the principal:</p>
    <p class="font-mono text-sm bg-muted p-3 rounded">Remaining Balance = Previous Balance − Principal Paid − Extra Payment</p>
    <p>The simulation stops when the balance reaches zero. Interest saved = Original total interest − New total interest. The earlier you start making extra payments, the greater the savings since you're reducing the principal that future interest is calculated on.</p>
  </div>
</CalculatorLayout>
