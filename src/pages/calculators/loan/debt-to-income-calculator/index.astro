---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { DebtToIncomeCalculator } from '@/components/calculators/debt-to-income-calculator/index.tsx'

const tool = getToolBySlug('debt-to-income-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'debt-to-income-calculator')
const { data } = entry!
---

<CalculatorLayout
  title={`Debt-to-Income Ratio Calculator - DTI Calculator | FinCalc Pro`}
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <DebtToIncomeCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    A <strong>debt-to-income ratio calculator</strong> helps you understand what percentage of your gross monthly income goes toward debt payments. Lenders use DTI to evaluate mortgage applications — knowing yours helps you prepare for a loan application or assess your financial health.
  </p>
  <div slot="how-to-use">
    <p>Enter your gross monthly income (before taxes). Then add all your monthly debt payments: housing payment (mortgage or rent), auto loans, credit cards, student loans, personal loans, and any other recurring obligations. The calculator shows your front-end DTI (housing only) and back-end DTI (all debts), with color-coded status indicators based on standard lender guidelines.</p>
  </div>
  <div slot="formula">
    <p><strong>Front-end DTI</strong> = (Monthly Housing Payment / Gross Monthly Income) × 100</p>
    <p><strong>Back-end DTI</strong> = (Total Monthly Debt Payments / Gross Monthly Income) × 100</p>
    <p>Typical lender guidelines: Front-end ≤ 28% is ideal, Back-end ≤ 36% is ideal. Back-end up to 43% may be acceptable for some loan programs. Housing payment includes principal, interest, taxes, insurance, PMI, and HOA dues.</p>
  </div>
</CalculatorLayout>
