---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getCollection } from 'astro:content'
import { AutoLoanCalculator } from '@/components/calculators/auto-loan-calculator/index.tsx'

const tool = getToolBySlug('auto-loan-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const [entry] = await getCollection('tools', ({ id }) => id === 'auto-loan-calculator')
const { data } = entry
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title={`${tool.name} - Estimate Your Monthly Car Payment | FinCalc Pro`} description={tool.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={tool.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      An <strong>auto loan calculator</strong> helps you estimate your monthly car payment based on the vehicle price, down payment, trade-in value, interest rate, and loan term. Know exactly what you'll pay before you visit the dealership.
    </p>

    <div class="my-8" id="calculator">
      <AutoLoanCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter the vehicle's price, your down payment, and any trade-in value. Add the interest rate (APR) and choose a loan term between 12 and 84 months. Click Calculate to see your monthly car payment, total interest paid over the loan term, and the full amount you'll pay including financing costs.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Auto loans use the same amortization formula as mortgages:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">M = P × [ i(1+i)^N ] / [ (1+i)^N − 1 ]</p>
        <p>Where P is the loan amount (vehicle price minus down payment and trade-in value), i is the monthly interest rate (APR / 12), and N is the total number of monthly payments (loan term in months). Total interest = (M × N) − P.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>