---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro'
import { getToolBySlug, getCategoryBySlug } from '@/data/tools'
import { getEntry } from 'astro:content'
import { AutoLoanCalculator } from '@/components/calculators/auto-loan-calculator/index.tsx'

const tool = getToolBySlug('auto-loan-calculator')!
const category = getCategoryBySlug(tool.category)!
const entry = await getEntry('tools', 'auto-loan-calculator')
const { data } = entry!
---

<CalculatorLayout
  title={`${tool.name} - Estimate Your Monthly Car Payment | FinCalc Pro`}
  description={data.description}
  toolName={tool.name}
  category={tool.category}
  categoryName={category.name}
  toolDescription={data.description}
  faqs={data.faqs}
  relatedSlug={tool.slug}
>
  <div slot="calculator">
    <AutoLoanCalculator client:load />
  </div>
  <p slot="intro" class="text-muted-foreground mb-8">
    An <strong>auto loan calculator</strong> helps you estimate your monthly car payment based on the vehicle price, down payment, trade-in value, interest rate, and loan term. Know exactly what you'll pay before you visit the dealership.
  </p>
  <div slot="how-to-use">
    <p>Enter the vehicle's price, your down payment, and any trade-in value. Add the interest rate (APR) and choose a loan term between 12 and 84 months. Click Calculate to see your monthly car payment, total interest paid over the loan term, and the full amount you'll pay including financing costs.</p>
  </div>
  <div slot="formula">
    <p>Auto loans use the same amortization formula as mortgages:</p>
    <p class="font-mono text-sm bg-muted p-3 rounded">M = P × [ i(1+i)^N ] / [ (1+i)^N − 1 ]</p>
    <p>Where P is the loan amount (vehicle price minus down payment and trade-in value), i is the monthly interest rate (APR / 12), and N is the total number of monthly payments (loan term in months). Total interest = (M × N) − P.</p>
  </div>
</CalculatorLayout>
