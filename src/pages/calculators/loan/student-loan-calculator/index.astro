---
import Layout from '@/layouts/Layout.astro'
import FAQBlock from '@/components/calculators/FAQBlock.astro'
import RelatedCalculators from '@/components/calculators/RelatedCalculators.astro'
import { getToolBySlug, getCategoryBySlug, getRelatedTools } from '@/data/tools'
import { getCollection } from 'astro:content'
import { StudentLoanCalculator } from '@/components/calculators/student-loan-calculator/index.tsx'

const tool = getToolBySlug('student-loan-calculator')!
const category = getCategoryBySlug(tool.category)!
const related = getRelatedTools(tool)
const [entry] = await getCollection('tools', ({ id }) => id === 'student-loan-calculator')
const { data } = entry
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: category.name, url: `/calculators/${category.slug}/` },
  { name: tool.name, url: '' },
]
---

<Layout title={`${tool.name} - Plan Your Repayment | FinCalc Pro`} description={tool.description} breadcrumbs={breadcrumbs} faq={data.faqs} toolName={tool.name} toolDescription={tool.description}>
  <article>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{tool.name}</h1>

    <p class="text-muted-foreground mb-8">
      A <strong>student loan calculator</strong> helps you understand how much you'll pay each month and over the life of your loan. Compare repayment timelines, see how extra payments save interest, and plan your debt payoff strategy.
    </p>

    <div class="my-8" id="calculator">
      <StudentLoanCalculator client:load />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How to Use This Calculator</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>Enter your total student loan balance, the average interest rate, and the loan term. The default monthly payment is the standard 10-year repayment amount. Adjust the monthly payment up or down to see how it affects your payoff timeline and total interest — higher payments clear debt faster and save on interest.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-foreground mb-3">How It's Calculated</h2>
      <div class="prose prose-sm max-w-none text-muted-foreground">
        <p>The standard monthly payment uses the amortization formula:</p>
        <p class="font-mono text-sm bg-muted p-3 rounded">M = P × [ i(1+i)^N ] / [ (1+i)^N − 1 ]</p>
        <p>Where P is the loan balance, i is the monthly interest rate, and N is the total number of payments. For a 10-year standard plan, N = 120. If you enter a different monthly payment, the calculator simulates how many months it takes to pay off the loan and the total interest paid.</p>
      </div>
    </section>

    {data.faqs && <FAQBlock faqs={data.faqs} />}

    <RelatedCalculators currentSlug={tool.slug} category={tool.category} />
  </article>
</Layout>