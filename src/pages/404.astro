---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404 — Page Not Found | FinCalc Pro" description="The page you are looking for does not exist. Browse our free financial calculators instead.">
  <div class="max-w-7xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
    <p class="text-xl text-muted-foreground mb-2">Page not found</p>
    <p class="text-muted-foreground mb-8 max-w-md mx-auto">
      The page you're looking for doesn't exist or has been moved. Try one of our calculators instead.
    </p>
    <a
      href="/calculators/"
      class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium text-sm hover:opacity-90 transition-opacity"
    >
      Browse All Calculators
    </a>
  </div>
</Layout>